# Copy this file to .env and fill in values
# cp .env.example .env

# Backend port
PORT=3001

# API base URL (Vite proxies /api → localhost:3001 in dev)
VITE_API_BASE_URL=/api

# ─────────────────────────────────────────────────────────────
# ITS 국가교통정보센터 CCTV API (전국 교통 CCTV — 무료)
# ─────────────────────────────────────────────────────────────
# 1. https://www.its.go.kr 회원가입
# 2. 마이페이지 → 인증키 신청 → 서비스: "CCTV 화상자료"
# 3. 보통 1시간 이내 승인
# API 키가 있으면 전국 수천 개 교통 CCTV가 자동으로 지도에 표시됩니다
DATA_GO_KR_API_KEY=

# ─────────────────────────────────────────────────────────────
# YouTube Data API (선택 — 유튜브 라이브 캠 검색용)
# ─────────────────────────────────────────────────────────────
# https://console.cloud.google.com → YouTube Data API v3 활성화
YOUTUBE_API_KEY=
